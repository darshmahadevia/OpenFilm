{
  "name": "openfilm",
  "productName": "OpenFilm",
  "description": "A local-first desktop workstation for reviewing and editing photographs.",
  "author": "OpenFilm contributors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": "22.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/darshmahadevia/OpenFilm.git"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --mac",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "perf:generate": "node scripts/generate-performance-corpus.mjs",
    "perf:run": "node scripts/run-performance-harness.mjs",
    "check:ui-slop": "node scripts/check-ui-slop.mjs",
    "test:release": "npm run check && npm run check:ui-slop && npm run test:e2e && npm run perf:generate && npm run perf:run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.openfilm.app",
    "productName": "OpenFilm",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.photography",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "icon": "build/icon.png",
      "artifactName": "OpenFilm.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "backgroundColor": "#050505",
      "iconSize": 112,
      "contents": [
        {
          "x": 150,
          "y": 185,
          "type": "file"
        },
        {
          "x": 390,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
